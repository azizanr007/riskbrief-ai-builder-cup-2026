# Firebase Web app identifiers are public client configuration, not credentials.
# Replace placeholders locally; never paste a Gemini API key here.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=REPLACE_WITH_RECAPTCHA_ENTERPRISE_SITE_KEY
VITE_FIREBASE_AI_LOGIC_ENABLED=false
